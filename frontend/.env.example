# Google AI Studio key, used to read resumes in the browser.
# It ships to the browser, so restrict it to your domain in Google Cloud.
VITE_GEMINI_API_KEY=

# Vapi public key, for the voice mock interview
VITE_VAPI_API_KEY=

# Firebase web config (Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
